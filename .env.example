# --- Database ---
# Local dev: docker compose up -d db  (see docker-compose.yml)
DATABASE_URL="postgresql://zombly:zombly@localhost:5432/zombly?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Resend (magic-link auth emails + alerts) ---
# Leave empty in dev: magic links are printed to the server console instead.
# In production, magic-link sign-in is disabled unless this is set (links
# are never printed to prod logs). Use owner login below, or Google, if
# you don't want to configure email.
RESEND_API_KEY=""
EMAIL_FROM="Zombly <auth@zombly.com>"

# --- Owner login (email-free sign-in for any deploy) ---
# Set BOTH to enable a built-in email+password sign-in for the owner —
# handy so a missing Resend/Google config never locks you out of prod.
# Use a long, unique password. Leave empty to disable.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Plaid (Phase 9 — sandbox creds from https://dashboard.plaid.com) ---
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cron (weekly digest) ---
# Vercel Cron sends this automatically as `Authorization: Bearer <secret>`
CRON_SECRET=""
